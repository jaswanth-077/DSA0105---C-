/* Smart Study Planner — Modern Desktop Theme */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #0F172A;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F8FAFC;
}

/* Sidebar Styling */
QWidget#sidebarWidget {
    background-color: #0F172A;
    border-right: 1px solid #1E293B;
}

QLabel#appLogoTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

QLabel#appLogoSub {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 500;
}

QPushButton.sidebarButton {
    background-color: transparent;
    color: #94A3B8;
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.sidebarButton:hover {
    background-color: #1E293B;
    color: #F8FAFC;
}

QPushButton.sidebarButton:checked {
    background-color: #4F46E5;
    color: #FFFFFF;
    font-weight: 600;
}

/* Cards */
QFrame.cardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame.cardFrameHover:hover {
    border: 1px solid #CBD5E1;
}

/* Typography */
QLabel.pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #0F172A;
}

QLabel.pageSubtitle {
    font-size: 13px;
    color: #64748B;
}

QLabel.sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #0F172A;
}

QLabel.cardValue {
    font-size: 26px;
    font-weight: 700;
    color: #0F172A;
}

QLabel.cardLabel {
    font-size: 12px;
    font-weight: 500;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel.cardSubtext {
    font-size: 11px;
    color: #94A3B8;
}

/* Buttons */
QPushButton.primaryButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: 1px solid #4338CA;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton.primaryButton:hover {
    background-color: #4338CA;
}

QPushButton.primaryButton:pressed {
    background-color: #3730A3;
}

QPushButton.secondaryButton {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.secondaryButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton.secondaryButton:pressed {
    background-color: #E2E8F0;
}

QPushButton.dangerButton {
    background-color: #EF4444;
    color: #FFFFFF;
    border: 1px solid #DC2626;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton.dangerButton:hover {
    background-color: #DC2626;
}

QPushButton.dangerButton:pressed {
    background-color: #B91C1C;
}

QPushButton.successButton {
    background-color: #10B981;
    color: #FFFFFF;
    border: 1px solid #059669;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton.successButton:hover {
    background-color: #059669;
}

/* Inputs & Form Controls */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 12px;
    color: #0F172A;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border: 1px solid #4F46E5;
    outline: none;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 12px;
    color: #0F172A;
    min-width: 120px;
}

QComboBox:focus {
    border: 1px solid #4F46E5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 4px;
    color: #0F172A;
    selection-background-color: #EEF2FF;
    selection-color: #4F46E5;
}

/* Tables */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #F1F5F9;
    selection-background-color: #EEF2FF;
    selection-color: #0F172A;
    outline: none;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:selected {
    background-color: #EEF2FF;
    color: #0F172A;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* Progress Bars */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 4px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: #334155;
    height: 10px;
}

QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 4px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F1F5F9;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #F1F5F9;
    height: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Dialogs */
QDialog {
    background-color: #FFFFFF;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #475569;
}
